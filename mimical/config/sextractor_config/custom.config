#-------------------------------- Catalog ------------------------------------
 
CATALOG_NAME     placeholder
CATALOG_TYPE     ASCII_HEAD

PARAMETERS_NAME  placeholder
 
#------------------------------- Extraction ----------------------------------
 
DETECT_TYPE      CCD
DETECT_MINAREA   10
DETECT_THRESH    2.5
ANALYSIS_THRESH  2.5
 
FILTER           Y
FILTER_NAME      placeholder
 
DEBLEND_NTHRESH  32
DEBLEND_MINCONT  0.0001
 
CLEAN            Y
CLEAN_PARAM      1.0
 
MASK_TYPE        CORRECT
 
#------------------------------ Photometry -----------------------------------
 
PHOT_APERTURES   11.66
PHOT_AUTOPARAMS  2.5, 3.5
PHOT_PETROPARAMS 2.0, 3.5
 
SATUR_LEVEL      50000.0
SATUR_KEY        SATURATE
 
MAG_ZEROPOINT    23.9
MAG_GAMMA        4.0
GAIN             0.0
GAIN_KEY         GAIN
PIXEL_SCALE      0.03
 
#------------------------- Star/Galaxy Separation ----------------------------
 
SEEING_FWHM      0.08
STARNNW_NAME     default.nnw
 
#------------------------------ Background -----------------------------------
 
BACK_SIZE        32
BACK_FILTERSIZE  3
BACKPHOTO_TYPE   GLOBAL
 
#------------------------------ Check Image ----------------------------------
 
CHECKIMAGE_TYPE  SEGMENTATION
CHECKIMAGE_NAME  check.fits
 
#--------------------- Memory (change with caution!) -------------------------
 
MEMORY_OBJSTACK  3000
MEMORY_PIXSTACK  300000
MEMORY_BUFSIZE   1024
 
#----------------------------- Miscellaneous ---------------------------------
 
VERBOSE_TYPE     NORMAL
HEADER_SUFFIX    .head
WRITE_XML        N
XML_NAME         sex.xml
